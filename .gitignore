*.py[cod]

# regenerable point clouds for the attractor figure
figures/.attractor-*.npy

# regenerable drive sweep behind CHAOS.md
figures/.chaos-*.json

# regenerable drive scans and basin grids behind DUFFING.md
figures/.duffing-*.json
figures/.duffing-*.npy
